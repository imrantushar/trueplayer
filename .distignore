# Patterns use .gitignore syntax. Everything listed here is EXCLUDED from the
# release zip (build via `npm run dist`). Ship only what the plugin needs at runtime.

# === Dev sources & toolchain ===
/assets/scss/
/assets/src/
package-lock.json
bun.lock

# Composer lock (manifests themselves are shipped alongside the built vendor/)
composer.lock

# === Cross-platform build kit (dev-only, never shipped) ===
/build-tools/
/build.config.json
/.build-cache/
/dist/

# === JS sources & build tooling (only assets/build ships) ===
/dev_trueplayer/
package.json
webpack.config.js
tailwind.config.js
postcss.config.js

# === JS / editor configs ===
.babelrc
.eslintignore
.eslintrc*
.prettierignore
.prettierrc*
jsconfig.json
.editorconfig

# === Internal notes & test output (never shipped) ===
/bug-reports/
/.playwright-mcp/
/test-results/
/tests/
/.auth/

# === VCS / IDE / OS / AI workspace ===
.git
.github
.gitattributes
.gitignore
.distignore
.idea
.vscode
.DS_Store
node_modules
.claude
.agents
openspec
CLAUDE.md
AGENTS.md

# === Misc ===
*.log
*.map
*.sh
*.yml
*.yaml
.travis.yml
.scrutinizer.yml
.codeclimate.yml
.editorconfig
DEVELOPERS.md
changelog.md

/docs/
