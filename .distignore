# Patterns use .gitignore syntax. Everything listed here is EXCLUDED from the
# release zip (build via `npm run dist`). Ship only what the plugin needs at runtime.

# === Dev sources & toolchain ===
/dev_trueplayer/
/assets/scss/
/assets/src/
webpack.config.js
tailwind.config.js
postcss.config.js
package.json
package-lock.json

# Composer manifests (the built vendor/ autoloader needs neither at runtime)
composer.json
composer.lock

# === Cross-platform build kit (dev-only, never shipped) ===
/build-tools/
/build.config.json
/.build-cache/
/dist/

# === JS / editor configs ===
.babelrc
.eslintignore
.eslintrc*
.prettierignore
.prettierrc*
jsconfig.json
.editorconfig

# === VCS / IDE / OS / AI workspace ===
.git
.github
.gitattributes
.gitignore
.distignore
.idea
.vscode
.DS_Store
node_modules
.claude
.agents
openspec
CLAUDE.md
AGENTS.md

# === Misc ===
*.log
*.map
*.sh
*.yml
*.yaml
.travis.yml
.scrutinizer.yml
.codeclimate.yml
.editorconfig
DEVELOPERS.md
changelog.md

# === Nested hidden/CI files inside vendored libraries (H5P) ===
addons/interactive/runtime/h5p-php-library/.gitignore
addons/interactive/runtime/h5p-php-library/.travis.yml
addons/interactive/runtime/h5p-editor-php-library/.gitignore
addons/interactive/runtime/h5p-php-library/doc/
addons/interactive/runtime/h5p-editor-php-library/README.md
addons/interactive/runtime/h5p-php-library/README.md
