{
  "slug": "trueplayer",
  "textdomain": "trueplayer",
  "mainFile": "trueplayer.php",
  "languages": "languages",
  "zipName": "{slug}.{version}.zip",
  "outputDir": "..",

  "versionFrom": "header",

  "steps": { "js": true, "composer": true, "strauss": false, "pot": true, "zip": true },

  "js": { "install": "auto", "installCommand": "npm ci --legacy-peer-deps", "buildScript": "build" },

  "pot": {
    "//": "dev_trueplayer is scanned, not excluded: it is where the admin app's strings live, and assets/build is the compiled copy of the same ones. ignoreDomain is required because the app calls __('text') through a wrapper that adds the domain itself.",
    "ignoreDomain": true,
    "exclude": ["node_modules", "assets/build", "openspec", "tests", "test-results", ".git", "languages"]
  },

  "autoDownloadTools": true,
  "toolVersions": { "wpCli": "2.12.0" }
}
